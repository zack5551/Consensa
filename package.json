{
  "name": "consensa",
  "version": "0.1.0",
  "private": true,
  "description": "Free, no-stakes Canadian prediction and polling app. EN/FR.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/pull-live-questions.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "fast-xml-parser": "5.12.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "eslint": "9.38.0",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": "8.5.32",
      "minimatch@>=7 <11.0.1": "^11.0.1"
    }
  }
}
